<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name="com.example.un.MonTempsApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpertSuivi">

        <activity
            android:name="com.example.un.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.example.un.ClientsActivity" android:exported="false" android:label="@string/title_clients" />
        <activity android:name="com.example.un.AddClientActivity" android:exported="false" android:label="Détail Patient" />
        <activity android:name="com.example.un.AgendaActivity" android:exported="false" android:label="@string/title_agenda" />
        <activity android:name="com.example.un.WorkHistoryActivity" android:exported="false" android:label="Historique Mensuel" />
        <activity android:name="com.example.un.VacationPeriodActivity" android:exported="false" android:label="Période de Congés" />
        <activity android:name="com.example.un.SalaryActivity" android:exported="false" android:label="@string/title_salaire" />
        <activity android:name="com.example.un.ScannerActivity" android:exported="false" android:label="@string/title_scanner" />
        <activity android:name="com.example.un.StatisticsActivity" android:exported="false" android:label="@string/title_stats" />
        <activity android:name="com.example.un.LieuxActivity" android:exported="false" android:label="@string/title_lieux" />
        <activity android:name="com.example.un.AddLieuActivity" android:exported="false" android:label="Ajouter Lieu" />
        <activity android:name="com.example.un.DocsActivity" android:exported="false" android:label="@string/title_docs" />
        <activity android:name="com.example.un.AddDocActivity" android:exported="false" android:label="Ajouter Doc" />
        <activity android:name="com.example.un.ScanAlbumActivity" android:exported="false" android:label="Album" />
        <activity android:name="com.example.un.ImageDetailActivity" android:exported="false" android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity android:name="com.example.un.ColleguesActivity" android:exported="false" android:label="@string/title_collegues" />
        <activity android:name="com.example.un.MessageGroupActivity" android:exported="false" android:label="Message Groupé" />
        <activity android:name="com.example.un.SharedMessagingActivity" android:exported="false" android:label="Discussion Forum" />
        <activity android:name="com.example.un.ForumActivity" android:exported="false" android:label="Forum de Discussion" />
        <activity android:name="com.example.un.ProfileActivity" android:exported="false" android:label="@string/title_profile" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
