<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA">

    <!-- Header Navigation Mensuelle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/brand_primary"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Mois précédent"/>

        <TextView
            android:id="@+id/tvCurrentMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mars 2025"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Mois suivant"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Carte Paramètres de Paie -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARAMÈTRES DE CALCUL"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Taux horaire brut (€)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTauxHoraire"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="12.50"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Prix Panier Repas (€)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTauxPanier"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="8.50"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbTachesComp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Appliquer les 5% (Tâches compl.)"
                        android:checked="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Résultats et Export -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#E8EAF6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvResultBrut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Brut : 0,00 €"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvResultDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Détails du calcul..."
                        android:textSize="14sp"
                        android:layout_marginTop="16dp"/>

                    <Button
                        android:id="@+id/btnExportSalaryPdf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EXPORTER BILAN PAIE (PDF)"
                        android:layout_marginTop="16dp"
                        app:icon="@android:drawable/ic_menu_save"
                        style="@style/Widget.MaterialComponents.Button"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnScanPayslip"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="SCANNER FEUILLE DE PAIE"
                android:layout_marginBottom="16dp"
                android:textColor="@color/white"
                android:backgroundTint="#FF6F00"
                app:icon="@android:drawable/ic_menu_camera"
                style="@style/Widget.MaterialComponents.Button"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONVENTIONS COLLECTIVES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnConvAmbu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ambulanciers"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:icon="@android:drawable/ic_menu_info_details"/>

                <Button
                    android:id="@+id/btnConvTaxi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Taxis"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:icon="@android:drawable/ic_menu_info_details"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
