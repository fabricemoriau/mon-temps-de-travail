<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Menu Principal du Scanner -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollScannerMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_scanner"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"
                android:textColor="@color/brand_primary"/>

            <Button
                android:id="@+id/btnScanRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_scan_route"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_camera"/>

            <Button
                android:id="@+id/btnScanCarnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_scan_carnet"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                app:icon="@drawable/ic_camera"/>

            <Button
                android:id="@+id/btnScanPaie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanner Fiche de Paie"
                android:layout_marginBottom="32dp"
                android:padding="16dp"
                android:backgroundTint="#FF6F00"
                android:textColor="@color/white"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnViewAlbumRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_view_album_route"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnViewAlbumCarnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_view_album_carnet"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnViewAlbumPaie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Album Fiches de Paie"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FF6F00"
                app:strokeColor="#FF6F00"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Interface CameraX (masquée par défaut) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:scaleType="fillCenter" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_camera"
        app:tint="@color/white"
        app:backgroundTint="@color/brand_primary"
        android:contentDescription="Capturer"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCloseCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:fabSize="mini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/white"
        app:backgroundTint="#80000000"
        android:contentDescription="Fermer"/>

    <TextView
        android:id="@+id/tvCameraHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Placez le document dans le cadre et capturez"
        android:textColor="@color/white"
        android:visibility="gone"
        android:background="#80000000"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnCapture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
