<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_collegues"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAddCollegue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_add_collegue"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etSearchCollegue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Rechercher un collègue..."
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:layout_marginBottom="8dp"
        android:padding="10dp"/>

    <Button
        android:id="@+id/btnGoToMessaging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messagerie Groupée"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAdminPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PANNEAU MAÎTRE (SÉCURITÉ)"
        android:backgroundTint="#D32F2F"
        android:textColor="@color/white"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollegues"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
