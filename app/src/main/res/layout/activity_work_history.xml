<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background_light">

    <!-- Header Navigation Mensuelle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/brand_primary"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Mois précédent"/>

        <TextView
            android:id="@+id/tvCurrentMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Juillet 2026"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:layout_marginStart="16dp"/>

        <ImageButton
            android:id="@+id/btnSearchMonth"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:scaleType="fitCenter"
            app:tint="#FFEB3B"
            android:contentDescription="Moteur de recherche par période"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/white"
            android:contentDescription="Mois suivant"/>
    </LinearLayout>

    <!-- Onglets des Mois -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabMonthSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        app:tabTextColor="#CCFFFFFF"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="#FFEB3B"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        android:elevation="4dp"/>

    <!-- Boutons d'action rapides -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#EEEEEE"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnSetVacation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONGÉS"
            android:textSize="12sp"
            android:textColor="#E65100"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:icon="@android:drawable/ic_menu_today"
            app:iconTint="#E65100"/>

        <Button
            android:id="@+id/btnShareMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORTER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_primary"
            style="@style/Widget.MaterialComponents.Button"
            app:icon="@android:drawable/ic_menu_share"
            app:iconTint="@color/white"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSyncGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNC"
            android:textSize="12sp"
            android:textColor="#1976D2"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:icon="@android:drawable/stat_notify_sync"
            app:iconTint="#1976D2"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvMonthTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total : 00h00"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/brand_primary"/>
    </LinearLayout>

    <!-- Grille Calendrier -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="L" android:gravity="center" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:gravity="center" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:gravity="center" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="J" android:gravity="center" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="V" android:gravity="center" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="D" android:gravity="center" android:textSize="12sp" android:textStyle="bold" android:textColor="#E91E63"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendarGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:clipToPadding="false"
        android:paddingBottom="24dp"/>

</LinearLayout>
