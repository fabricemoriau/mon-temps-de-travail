<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <EditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPrenom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_prenom"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etSociete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_societe"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAnciennete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_anciennete"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPoste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_poste"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAdressePerso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_adresse_perso"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAdresseTravail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_adresse_travail"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tel"
            android:inputType="phone"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etAdminCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Code d'activation Maître (Optionnel)"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PARAMÈTRES DE PAIE"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Base Heures Mensuelles (ex: 151.67)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBaseHeures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="151.67"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Taux Horaire NET (€)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTauxNetBase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="12.50"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Majoration Nuit % (ex: 25)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMajorNuit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="25"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Prime Dimanche/Férié € (ex: 26.30)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrimeDimanche"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="26.30"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Prime Garde SAMU € (ex: 30.00)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrimeGardeSamu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="30.00"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Taux Panier Repas € (ex: 9.20)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTauxPanier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="9.20"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCalcMensuel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calcul Heures Sup sur base Mensuelle (plutôt que Journalière 8h30)"
                    android:textSize="12sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUALIFICATIONS PROFESSIONNELLES"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/cbDeaCca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DEA / CCA"/>

                <CheckBox
                    android:id="@+id/cbTaxis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Taxis"/>

                <CheckBox
                    android:id="@+id/cbAuxiliaire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auxiliaire"/>

                <CheckBox
                    android:id="@+id/cbAutre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Autre"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Bonus 5% (Tâches compl.) activé si 2 cases cochées."
                    android:textSize="10sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/brand_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SÉCURITÉ &amp; SAUVEGARDE"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Créez un fichier de secours contenant TOUTES vos données (heures, patients, codes). Ce fichier pourra être restauré sur un autre téléphone."
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnExportBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPORTER TOUTES MES DONNÉES (JSON)"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@android:drawable/ic_menu_save"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnExportPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPORTER MES DOCUMENTS (Photos ZIP)"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@android:drawable/ic_menu_camera"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnRestoreBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESTAURER DONNÉES"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:icon="@android:drawable/ic_menu_revert"
                    android:textColor="@color/brand_primary"/>

                <Button
                    android:id="@+id/btnRestorePhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESTAURER PHOTOS (ZIP)"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    app:icon="@android:drawable/ic_input_add"
                    android:textColor="@color/brand_primary"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
