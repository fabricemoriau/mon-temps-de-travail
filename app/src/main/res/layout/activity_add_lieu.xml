<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAddLieuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_add_lieu"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etLieuNom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_lieu_nom"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etLieuCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_lieu_code"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etLieuTel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Téléphone"
        android:inputType="phone"
        android:layout_marginBottom="8dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etLieuAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adresse"
            android:inputType="textPostalAddress"
            android:layout_toStartOf="@+id/btnLieuGps"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/btnLieuGps"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_mylocation"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="GPS"/>
    </RelativeLayout>

    <EditText
        android:id="@+id/etLieuNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_lieu_notes"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:minLines="3"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveLieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_lieu"/>

</LinearLayout>
