<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_light">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_message_group"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etMessageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_message_content"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:gravity="top"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Destinataires :"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectCollegues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSendToAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_send_all"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button"/>

    <Button
        android:id="@+id/btnSendToSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_send_selected"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</LinearLayout>
