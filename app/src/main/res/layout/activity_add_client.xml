<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background_light">

    <!-- Header Fixe -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOUVELLE FICHE PATIENT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@color/brand_primary"
        android:padding="20dp"
        android:elevation="4dp"
        android:gravity="center"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/etClientNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nom"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="16dp"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:autofillHints="name"/>

            <EditText
                android:id="@+id/etClientPrenom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_prenom"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="16dp"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:autofillHints="personGivenName"/>

            <EditText
                android:id="@+id/etClientTel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_tel"
                android:inputType="phone"
                android:layout_marginBottom="16dp"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:autofillHints="phone"/>

            <EditText
                android:id="@+id/etClientDateNaissance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date de naissance (JJ/MM/AAAA)"
                android:inputType="phone"
                android:maxLength="10"
                android:layout_marginBottom="16dp"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:autofillHints="none"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADRESSE DU PATIENT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="8dp"/>

            <!-- Choix GPS -->
            <Button
                android:id="@+id/btnGpsLocation"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="DÉTECTER PAR GPS"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_gps"
                app:iconGravity="textStart"/>

            <!-- Saisie Manuelle -->
            <EditText
                android:id="@+id/etClientAdresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ou saisir l'adresse manuellement..."
                android:inputType="textPostalAddress"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:autofillHints="postalAddress"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etClientNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_notes"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:gravity="top"
                android:padding="15dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="24dp"/>

            <CheckBox
                android:id="@+id/cbIsDecedee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_decedee"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnSaveClient"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="ENREGISTRER LA FICHE"
                android:textSize="18sp"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
